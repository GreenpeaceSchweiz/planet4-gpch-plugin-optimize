	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"format:php": "vendor/bin/phpcbf --standard=WordPress --extensions=php ./classes/ planet4-gpch-plugin-optimize.php",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:php": "vendor/bin/phpcs -ps --extensions=php ./classes/ planet4-gpch-plugin-optimize.php",
		"fix:js": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"env": "wp-env"
	},
	"devDependencies": {
		"@wordpress/env": "^11.14.0",
		"@wordpress/scripts": "^34.2.0"
	},
	"dependencies": {
		"@wordpress/block-editor": "^17.0.0",
		"@wordpress/blocks": "^15.27.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/data": "^10.54.0",
		"@wordpress/element": "^8.6.0",
		"@wordpress/i18n": "^6.27.0",
		"@wordpress/icons": "^15.5.0"
	}
